#include <winver.h>

1 ICON "build/windows/icon.ico"
1 24  "app.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION    1,2,0,0
    PRODUCTVERSION 1,2,0,0
    FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
    FILEFLAGS      0
    FILEOS         VOS__WINDOWS32
    FILETYPE       VFT_APP
    FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "MaxSlion"
            VALUE "FileDescription",  "SSH Endpoint Forwarding Client"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "client-wails"
            VALUE "OriginalFilename", "client-wails.exe"
            VALUE "ProductName",      "Endpoint Forwarding"
            VALUE "ProductVersion",   "1.2.0.0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 MaxSlion"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
